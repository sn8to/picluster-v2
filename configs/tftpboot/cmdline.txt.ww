{{- nobackup }}
{{- range $node := .AllNodes }}
{{- if .Tags.Serial }}
{{- $netdev := .NetDevs.default }}
{{- $baseuri := "" }}
{{- if $.Ipaddr6 }}
{{- $baseuri = print "http://[" $.Ipaddr6 "]:" $.Warewulf.Port "/provision/" .NetDevs.default.Hwaddr }}
{{- else }}
{{- $baseuri = print "http://" $.Ipaddr ":" $.Warewulf.Port "/provision/" .NetDevs.default.Hwaddr }}
{{- end }}
{{- file (print .Tags.Serial "/cmdline.txt") }}
rd.shell rd.neednet=1 root=wwinit:{{default "tmpfs" .Root}} wwinit.uri={{ $baseuri }} wwid={{$netdev.Hwaddr}} {{ .Kernel.Args | join " " }}
{{ end -}}
{{- end }}