{{- nobackup }}
{{- range $node := .AllNodes -}}
{{- if .Tags.Serial }}
{{- file (print .Tags.Serial "/config.txt") }}
{{- $firmware := printf "/%s/%s" .ImageName ( default "efi" .Tags.Firmware ) }}
usb_max_current_enable=1
arm_boost=1
dtparam=pciex1_gen=3
os_prefix={{ $firmware }}/
kernel=kernel8.img
initramfs initramfs8
{{ end -}}
{{- end}}